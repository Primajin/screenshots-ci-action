{
  "name": "screenshots-ci-action",
  "version": "4.0.0",
  "description": "GitHub Action that captures desktop and multi-device website screenshots with Playwright and saves them as artifacts, posts them to pull requests or sends them to Telegram",
  "license": "MIT",
  "repository": "github:Primajin/screenshots-ci-action",
  "homepage": "https://github.com/Primajin/screenshots-ci-action#readme",
  "bugs": "https://github.com/Primajin/screenshots-ci-action/issues",
  "author": "Primajin",
  "type": "module",
  "exports": "./index.js",
  "sideEffects": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "xo",
    "lint:fix": "xo --fix",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "files": [
    "index.js",
    "action.yml",
    "capture.js",
    "comment.js",
    "comment-options.js",
    "image-size.js",
    "page-problems.js",
    "pr-comment.js",
    "pre-script.js",
    "screenshots-dir.js",
    "status-bar.js",
    "telegram.js",
    "utils.js"
  ],
  "keywords": [
    "github-action",
    "github-actions",
    "screenshot",
    "screenshots",
    "playwright",
    "chromium",
    "responsive",
    "devices",
    "pull-request",
    "telegram",
    "ci"
  ],
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/io": "^3.0.2",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "vitest": "^5.0.5",
    "xo": "^5.0.1"
  }
}
