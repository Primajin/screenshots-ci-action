{
    "env": {
        "commonjs": true,
        "es6": true,
        "node": true
    },
    "plugins": ["prettier"],
    "extends": ["prettier", "eslint:recommended"],
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly"
    },
    "parserOptions": {
        "ecmaVersion": 2020
    },
    "overrides": [
      {
        "files": ["*.test.js"],
        "parserOptions": { "sourceType": "module" }
      }
    ],
    "rules": {
      "prettier/prettier": "error"
    }
}